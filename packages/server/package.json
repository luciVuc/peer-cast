{
  "name": "@peer-cast/server",
  "version": "1.1.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "PeerCast backend: Express API + PeerJS signaling + SQLite. Serves the PWA.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
