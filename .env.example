# ─── PeerCast server configuration ─────────────────────────────────────────────
#
# Copy this file to .env and adjust the values.
# All variables have sane defaults for local development.
# Variables marked REQUIRED must be set before going to production.
#
# After editing: restart the server (or rebuild the Docker image).

# ─── HTTP server ─────────────────────────────────────────────────────────────

PORT=8787          # port the server listens on
HOST=0.0.0.0       # bind address (0.0.0.0 = all interfaces)

# Run mode. development keeps the server forgiving (ephemeral JWT_SECRET fallback)
# so a freshly-copied .env boots for local work. Set to production — and provide
# a strong JWT_SECRET (below) — before exposing the server publicly. The server
# refuses to boot in production with a missing or placeholder secret.
NODE_ENV=development

# ─── Public hostname ─────────────────────────────────────────────────────────
# The domain or IP that clients (browsers, extension) use to reach this server.
# Used to build the PeerJS signaling address advertised via GET /api/config.
# REQUIRED in production.

PUBLIC_HOST=peercast.example.com
PUBLIC_SECURE=true     # true when serving over HTTPS/WSS (required for WebRTC + getDisplayMedia)

# ─── Auth tokens ─────────────────────────────────────────────────────────────
# REQUIRED: JWT_SECRET must be a long random string in production.
# Changing it invalidates all existing sessions.
# Generate a good one: openssl rand -hex 32

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m          # access token lifetime (ms-compatible string)
JWT_REFRESH_TTL_SEC=604800  # refresh token lifetime in seconds (default 7 days)

# Refresh-cookie SameSite policy. This build is single-origin by design, so
# the default (strict) is the safest. Use lax if you route the app behind a
# proxy with a different site (top-level navigations only). Use none ONLY for
# truly cross-origin setups; it requires HTTPS (cookies with SameSite=None
# must be Secure).
# COOKIE_SAME_SITE=strict

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite file path. In Docker, mount the parent directory as a volume so data
# persists across container restarts.

DATABASE_FILE=/data/peercast.db

# ─── Redis (optional) ─────────────────────────────────────────────────────────
# When unset, the server uses in-process stores:
#   • rate limiting (correct for a single-process deployment)
#   • signaling ticket mint/consume (peerId-bound, 2 min TTL, single-use)
#
# Set REDIS_URL to share both across multiple server instances behind a load
# balancer:
#   • rate-limit counters become consistent across instances
#   • a signaling ticket minted on instance A validates on instance B
#
# If REDIS_URL is set but the server cannot reach Redis, rate-limited endpoints
# fail closed (429/500) rather than silently un-limiting auth — keep an eye on
# the log line for connection failures.
# REDIS_URL=redis://localhost:6379/0

# ─── Admin accounts ──────────────────────────────────────────────────────────
# Comma-separated @handles that may be bootstrapped as admins when registration
# includes the operator-controlled ADMIN_BOOTSTRAP_SECRET. Admins get /admin.
#
# Leave unset if you don't need admin accounts.
# ADMIN_USERNAMES=alice,bob
# ADMIN_BOOTSTRAP_SECRET=generate-a-separate-random-secret

# ─── Registration mode ───────────────────────────────────────────────────────
# Controls who can create new accounts:
#
#   open    — anyone can register (default)
#   invite  — a valid invite code is required; admins mint codes in /admin → Invites
#   closed  — no new registrations (existing users still work)
#
# REGISTRATION_MODE=open

# ─── Email verification ───────────────────────────────────────────────────────
# By default (false), email verification is SOFT — users can log in and broadcast
# while unverified, but see a verification banner on the Dashboard.
#
# Set to true to HARD-BLOCK login until the email address is verified.
# REQUIRE_EMAIL_VERIFICATION=false

# ─── Email (Nodemailer / SMTP) ────────────────────────────────────────────────
# Used for email verification links and password-reset links.
#
# If SMTP_HOST is NOT set, emails are printed to the server log (stdout) with
# bearer tokens redacted. This is intended for development/single-operator use;
# configure SMTP for production delivery.
#
# Works with any SMTP provider. Common choices:
#
#   Resend (recommended, free 100/day):
#     SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend  SMTP_PASS=re_xxxx
#
#   Mailgun (free 1000/day trial):
#     SMTP_HOST=smtp.mailgun.org  SMTP_PORT=587
#     SMTP_USER=postmaster@yourdomain.mailgun.org  SMTP_PASS=<key>
#
#   SendGrid:
#     SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASS=<key>
#
#   AWS SES (needs verified domain):
#     SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_PORT=587
#     SMTP_USER=<SES SMTP username>  SMTP_PASS=<SES SMTP password>
#
#   Gmail (requires App Password — not your account password):
#     SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<app-password>
#
#   Self-hosted Postfix (zero external dependency):
#     SMTP_HOST=localhost  SMTP_PORT=25
#     (install postfix on the same machine: apt install postfix)

# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465 (SMTPS); false for STARTTLS (port 587)
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxx
# SMTP_FROM=PeerCast <noreply@yourdomain.com>

# The base URL embedded in email links. Must be publicly reachable.
# REQUIRED if email is configured.
# APP_URL=https://peercast.example.com

# ─── Signaling (PeerJS) ───────────────────────────────────────────────────────
# The self-hosted PeerJS signaling server. Usually leave these as-is.
# Clients derive host/port/secure from their own window.location and read
# path + key from GET /api/config.

SIGNAL_PATH=/peerjs
SIGNAL_KEY=peercast
# SIGNAL_HOST defaults to PUBLIC_HOST
# SIGNAL_PORT defaults to PORT

# ─── ICE servers (STUN / TURN) ────────────────────────────────────────────────
# Advertised to ALL clients (web viewer, web broadcaster, extension) via
# GET /api/config. Clients use these for WebRTC connection establishment.
#
# Default (unset): Google STUN only. Works for most networks but fails behind
# symmetric NAT (common on corporate networks, some mobile carriers).
#
# To also handle symmetric NAT, add a TURN relay:
#
#   With the bundled coturn container (docker compose --profile turn up -d):
#     - Edit turn/turnserver.conf: set external-ip, change static-auth-secret
#     - Set TURN_SHARED_SECRET below to the same value
#     - Open UDP 3478 + 49160-49200 on your firewall
#     - Then set:
#
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:YOUR_HOST:3478"}]
#
#   TURN credentials rotate automatically: when TURN_SHARED_SECRET is set, the
#   server issues time-limited credentials (username + HMAC-SHA1 credential,
#   24 h TTL) to every client via GET /api/config — no static username/
#   credential is ever sent. Static username/credential in ICE_SERVERS is
#   ignored while TURN_SHARED_SECRET is set.
#
# TURN_SHARED_SECRET=change-me-to-a-long-random-secret
# TURN_TTL_SEC=86400          # credential lifetime in seconds (default 24 h)
# TURN_USERID=peercast        # userid embedded in the auth username

# ─── Web Push (optional) ─────────────────────────────────────────────────────
# Lets followers enable "notify me when a followed user goes live" — a real
# push notification delivered by the browser's push service. When unset the
# feature is disabled and the web app never prompts for permission.
# Generate a keypair once with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@peercast.local   # visible to push service ops

# ─── Recordings (per-broadcast replay, optional) ──────────────────────────────
# WebM files saved when a broadcaster hits "Record" on the broadcast page.
# Defaults to <datadir>/recordings (same volume as the SQLite DB in Docker).
# RECORDINGS_DIR=
# RECORDINGS_MAX_BYTES=536870912   # per-recording cap (default 512 MB)

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for the API. Use * to allow any origin.
# In production with a known domain, restrict this:
# CORS_ORIGINS=https://peercast.example.com

CORS_ORIGINS=*

# ─── App identity ────────────────────────────────────────────────────────────
APP_NAME=PeerCast    # shown in the UI and email subjects
